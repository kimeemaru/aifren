# Local character assets remain ignored except for the cleared default
# VRoidPreset_A asset required by a public clone to load the default avatar.
unity/AIFrenUnityPoc/Assets/Resources/LocalCharacter/
!unity/AIFrenUnityPoc/Assets/Resources/LocalCharacter/
!unity/AIFrenUnityPoc/Assets/Resources/LocalCharacter/model.vrm
!unity/AIFrenUnityPoc/Assets/Resources/LocalCharacter/model.vrm.meta

# Optional user-supplied companion backgrounds. The runtime configuration
# refers to Resources/LocalBackground/background when a local Sprite exists.
unity/AIFrenUnityPoc/Assets/Resources/LocalBackground/
unity/AIFrenUnityPoc/Assets/Resources/LocalBackground.meta

# Reviewed, redistributable presentation assets. User-supplied local media
# remains ignored by the broader audio/avatar rules above.
!unity/AIFrenUnityPoc/Assets/Resources/Presentation/
!unity/AIFrenUnityPoc/Assets/Resources/Presentation/**


